logs/*.log
*.log
logs/*.txt


# ------------------------------------------------------------
# Testing, coverage, and linting caches
# ------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

.tox/
.nox/

.mypy_cache/
.ruff_cache/
.cache


# ------------------------------------------------------------
# DATA
# ------------------------------------------------------------
# Ignore actual raw, external, interim, and processed data files.
# This is important because MSME financial data may be large,
# sensitive, proprietary, or protected under KDPA.
# ------------------------------------------------------------

data/raw/*
data/external/*
data/interim/*
data/processed/*

# Keep folder structure and explanation files
!data/raw/.gitkeep
!data/raw/README.md

!data/external/.gitkeep
!data/external/README.md

!data/interim/.gitkeep
!data/interim/README.md

!data/processed/.gitkeep
!data/processed/README.md

# Keep all metadata files
!data/metadata/
!data/metadata/**

# Keep synthetic sample data used for testing and demo
!data/synthetic/
!data/synthetic/**

# Keep top-level data README
!data/README.md


# ------------------------------------------------------------
# MODELS
# ------------------------------------------------------------
# Ignore trained model binaries and preprocessing artifacts.
# These can usually be regenerated using training scripts.
# ------------------------------------------------------------

models/trained/*
models/preprocessing/*

# Keep placeholders and documentation
!models/trained/.gitkeep
!models/trained/README.md

!models/preprocessing/.gitkeep
!models/preprocessing/README.md

# Keep model metrics because they are useful for Chapter 5:
# Testing and Results.
!models/metrics/
!models/metrics/**

# Keep models README
!models/README.md


# ------------------------------------------------------------
# Common large binary artifacts
# ------------------------------------------------------------
*.sqlite
*.sqlite3
*.db

*.pkl
*.pickle

*.joblib

*.onnx
*.pt
*.pth
*.h5
*.pb
*.tflite

*.parquet
*.feather
*.arrow
*.orc

*.npy
*.npz


# ------------------------------------------------------------
# Reports and generated outputs
# ------------------------------------------------------------
# Keep report markdown and small CSVs by default.
# If figures become very large, you can ignore them later.

# Optional: ignore generated EDA figures but keep .gitkeep
# reports/eda/figures/*
# !reports/eda/figures/.gitkeep

# Optional: ignore generated model performance figures but keep .gitkeep
# reports/model_performance/figures/*
# !reports/model_performance/figures/.gitkeep


# ------------------------------------------------------------
# Streamlit
# ------------------------------------------------------------
# Track config.toml, but ignore secrets.
.streamlit/secrets.toml
.streamlit/*.local.toml


# ------------------------------------------------------------
# Docker
# ------------------------------------------------------------
deployment/docker/.env
docker-compose.override.yml


# ------------------------------------------------------------
# Temporary Office files
# ------------------------------------------------------------
~$*.docx
~$*.xlsx
~$*.pptx
*.tmp
*.temp
*.bak
*.backup


# ------------------------------------------------------------
# Optional ML experiment tracking folders
# ------------------------------------------------------------
mlruns/
wandb/
lightning_logs/
tensorboard/
runs/