# ============================================================
# BizFlow360 .gitignore
# Team Maridex Capstone Project
# ============================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg

# Virtual environments
venv/
env/
ENV/
.venv/

# Environment variables and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
secrets.toml
.streamlit/secrets.toml

# Jupyter
.ipynb_checkpoints/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/

# DATA - Ignore actual data files but keep folder structure
denis_data_eda/raw/*
denis_data_eda/processed/*
!denis_data_eda/raw/.gitkeep
!denis_data_eda/raw/README.md
!denis_data_eda/processed/.gitkeep
!denis_data_eda/processed/README.md
!denis_data_eda/synthetic/
!denis_data_eda/metadata/

# MODELS - Ignore trained models but keep metrics
edusei_ml/models/trained/*
edusei_ml/models/preprocessing/*
!edusei_ml/models/trained/.gitkeep
!edusei_ml/models/preprocessing/.gitkeep
!edusei_ml/models/metrics/

# Large binary files
*.joblib
*.pkl
*.pickle
*.parquet
*.feather

# Temporary files
*.tmp
*.temp
*.bak
