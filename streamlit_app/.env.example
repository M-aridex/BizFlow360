# BizFlow360 Environment Variables
# Copy this file to .env and fill in your values

# Data paths
DATA_RAW_PATH=../denis_data_eda/raw
DATA_PROCESSED_PATH=../denis_data_eda/processed
DATA_SYNTHETIC_PATH=../denis_data_eda/synthetic

# Model paths
MODEL_PATH=../edusei_ml/models/trained/best_model.joblib
SCALER_PATH=../edusei_ml/models/preprocessing/scaler.joblib

# App settings
APP_ENV=development
APP_DEBUG=True
APP_PORT=8501

# Deployment (Yvette will fill these in)
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=True
